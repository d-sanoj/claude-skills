[{"find":"amount_cents <= 10000","label":"$100 boundary: <= 10000 -> < 10000","replace":"amount_cents < 10000"},{"find":"amount_cents <= 50000","label":"$500 boundary: <= 50000 -> < 50000","replace":"amount_cents < 50000"},{"find":"return 5","label":"mid-tier rate: return 5 -> return 10","replace":"return 10"},{"find":"return 10","label":"top-tier rate: return 10 -> return 0","replace":"return 0"},{"find":"return 0","label":"no-discount rate: return 0 -> return 5","replace":"return 5"},{"find":"date(expiry_year, expiry_month, 1) < today","label":"expiry day: < today -> <= today","replace":"date(expiry_year, expiry_month, 1) <= today"},{"find":"amount_cents * (100 - rate) // 100","label":"price formula: (100 - rate) -> (100 + rate)","replace":"amount_cents * (100 + rate) // 100"},{"find":"amount_cents * (100 - rate) // 100","label":"price divisor: // 100 -> // 99","replace":"amount_cents * (100 - rate) // 99"},{"find":"date(expiry_year, expiry_month, 1)","label":"expiry month ignored: month -> January","replace":"date(expiry_year, 1, 1)"},{"find":"amount_cents * (100 - rate) // 100","label":"price division: // 100 -> / 100 (float cents)","replace":"amount_cents * (100 - rate) / 100"}]